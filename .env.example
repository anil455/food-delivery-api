APP_NAME="Food Delivery API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=food_delivery
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Frontend / CORS ───────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Auth ──────────────────────────────────────────────────────
SANCTUM_CUSTOMER_TOKEN_TTL_MINUTES=43200
SANCTUM_STAFF_TOKEN_TTL_MINUTES=720

# ─── OTP ───────────────────────────────────────────────────────
OTP_DRIVER=log
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_EXPOSE_IN_RESPONSE=false
OTP_TEST_NUMBERS=

# Provider credentials — never commit real values
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# ─── Geo / delivery defaults ───────────────────────────────────
GEO_DEFAULT_SEARCH_RADIUS_KM=10
GEO_MAX_SEARCH_RADIUS_KM=25
GEO_NEARBY_RESULT_LIMIT=50

# Free tier at https://locationiq.com — no card required.
LOCATIONIQ_API_KEY=
REVERSE_GEOCODE_CACHE_MINUTES=1440
APP_CURRENCY=INR
APP_CURRENCY_MINOR_UNITS=100

# ─── Transactional SMS (order updates, separate from OTP) ──────
SMS_DRIVER=log
SMS_ENABLED=true
SMS_SENDER_NAME="Food Delivery"

# ─────────────────────────────────────────────────────────────
# Production checklist
# ─────────────────────────────────────────────────────────────
# The values above are development defaults. For production:
#
#   APP_ENV=production
#   APP_DEBUG=false                  never true: it leaks SQL and stack traces
#   OTP_EXPOSE_IN_RESPONSE=false     the app refuses to boot if this is true
#   OTP_TEST_NUMBERS=                same: fixed codes must not exist in production
#
#   OTP_DRIVER=msg91                 or twilio, with the credentials above
#   SMS_DRIVER=msg91                 order updates; can differ from OTP
#
# Redis replaces the database driver for anything hot. Rate limiting in
# particular reads and writes on every request and does not belong in MySQL:
#
#   CACHE_STORE=redis
#   SESSION_DRIVER=redis
#   QUEUE_CONNECTION=redis
#   REDIS_HOST=127.0.0.1
#   REDIS_PASSWORD=
#   REDIS_PORT=6379
#
# QUEUE_CONNECTION=sync above runs jobs inline, which is fine locally but means
# a slow SMS gateway would hold up an HTTP response. In production run a worker:
#
#   php artisan queue:work --queue=otp,notifications,default --tries=3
#
# And the scheduler, which prunes expired tokens and OTP rows:
#
#   php artisan schedule:work        (or a cron entry calling schedule:run)
#
# FRONTEND_URL accepts a comma-separated list; it is the CORS allowlist.
#
#   FRONTEND_URL=https://app.example.com,https://staging.example.com
